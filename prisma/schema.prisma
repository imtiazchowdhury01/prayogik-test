// ============================================
// AFFILIATE EARNINGS
// ============================================

model AffiliateEarning {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  affiliateProfileId String           @db.ObjectId
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)
  sourcePurchaseId   String           @db.ObjectId
  sourcePurchase     Purchase         @relation(fields: [sourcePurchaseId], references: [id])
  amountTk           Float
  commissionRate     Float
  status             CommissionStatus @default(PENDING)
  idempotencyKey     String           @unique
  approvedAt         DateTime?
  paidAt             DateTime?
  rejectedAt         DateTime?
  rejectionReason    String?
  month              Int
  year               Int
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateProfileId])
  @@index([status])
  @@index([sourcePurchaseId])
  @@index([affiliateProfileId, month, year])
}

// ============================================
// COURSE & CONTENT MODELS
// ============================================

model Category {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  name    String  @unique
  slug    String  @unique
  isChild Boolean @default(false)

  // Self-referential Hierarchy
  parentCategoryId String?    @db.ObjectId
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childCategories  Category[] @relation("CategoryHierarchy")

  // Relations
  courses          Course[]
  certificationIds String[]        @db.ObjectId
  certifications   Certification[] @relation(fields: [certificationIds], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([parentCategoryId])
  @@index([isChild])
}

model Course {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  title               String
  slug                String          @unique
  description         String?
  imageUrl            String?
  totalDuration       Int?
  learningOutcomes    String[]
  requirements        String[]
  whoFor              String[]
  prices              Price[]
  isPublished         Boolean         @default(false)
  isUnderSubscription Boolean         @default(false)
  courseType          CourseType      @default(MINI)
  ownership           CourseOwnership @default(TEACHER)
  feePercentage       Float?
  feeAmount           Float?

  // Course Mode (Recorded or Live)
  courseMode               CourseMode     @default(RECORDED)
  courseLiveLink           String?
  courseLiveLinkPassword   String?
  courseLiveBatchStartedAt DateTime?
  totalLiveClass           Int?
  liveSchedules            LiveSchedule[]

  // Teacher Relations
  teacherProfileId String           @db.ObjectId
  teacherProfile   TeacherProfile   @relation("TeacherCourses", fields: [teacherProfileId], references: [id])
  coTeacherIds     String[]         @db.ObjectId
  coTeachers       TeacherProfile[] @relation("CourseCoTeachers", fields: [coTeacherIds], references: [id])

  // Category
  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])

  // Content
  lessons     Lesson[]
  attachments Attachment[]

  // Membership & Bundles
  membershipPlanIds String[]         @db.ObjectId
  membershipPlans   MembershipPlan[] @relation("CourseMemberships", references: [id], fields: [membershipPlanIds])
  bundleIds         String[]         @db.ObjectId
  bundles           Bundle[]         @relation("BundleCourses", references: [id], fields: [bundleIds])
  certificationIds  String[]         @db.ObjectId
  certifications    Certification[]  @relation("CertificationCourses", references: [id], fields: [certificationIds])

  // Subscription
  subscriptionPlanId  String?           @db.ObjectId
  subscriptionPlan    SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  trialSubscriptionId String?           @db.ObjectId
  trialSubscription   Subscription?     @relation("TrialCourses", fields: [trialSubscriptionId], references: [id])

  // Engagement
  rating           Rating[]
  review           Review[]
  comment          Comment[]
  enrolledStudents EnrolledStudents[]

  // Purchases
  purchases            Purchase[]
  bkashPurchaseHistory BkashPurchaseHistory[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([isPublished])
  @@index([isUnderSubscription, isPublished])
  @@index([teacherProfileId, isPublished])
  @@index([categoryId, isPublished])
}

model Lesson {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String
  description String?
  textContent String?
  videoUrl    String?
  videoStatus VideoUploadingStatus @default(PROCESSING)
  position    Int
  isPublished Boolean              @default(false)
  isFree      Boolean              @default(false)
  duration    Int?

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  Progress Progress[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([courseId, slug]) // Add this line
  @@index([courseId, isPublished])
  @@index([courseId, isPublished, position])
  @@index([courseId, isPublished, position, id])
}

model LiveSchedule {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  courseId  String    @db.ObjectId
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime DateTime
  endTime   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, dayOfWeek])
}

model Attachment {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String
  url  String

  courseId String @db.ObjectId
  course   Course @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model VdocipherUploads {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  videoId     String?              @unique
  duration    Int
  courseId    String               @db.ObjectId
  lessonId    String               @db.ObjectId
  videoStatus VideoUploadingStatus @default(PROCESSING)
  payload     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Certification {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  slug             String          @unique
  excerpt          String?
  imageUrl         String?
  description      String?
  learningOutcomes String[]
  faqs             Faq[]
  whofor           String?
  level            DifficultyLevel @default(BEGINNER)
  isPublished      Boolean         @default(false)

  // Skills
  skillIds String[]   @db.ObjectId
  skills   Category[] @relation(fields: [skillIds], references: [id])

  // Pricing
  prices Price[]

  // Courses
  courseIds String[] @db.ObjectId
  courses   Course[] @relation("CertificationCourses", references: [id], fields: [courseIds])

  // Teachers
  teacherProfileId String           @db.ObjectId
  teacherProfile   TeacherProfile   @relation("TeacherCertifications", fields: [teacherProfileId], references: [id])
  coTeacherIds     String[]         @db.ObjectId
  coTeachers       TeacherProfile[] @relation("CertificationCoTeachers", fields: [coTeacherIds], references: [id])

  // Enrollment & Purchases
  enrolledStudents     EnrolledStudents[]
  purchases            Purchase[]
  bkashPurchaseHistory BkashPurchaseHistory[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Bundle {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  prices      Price[]

  courseIds String[] @db.ObjectId
  courses   Course[] @relation("BundleCourses", references: [id], fields: [courseIds])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model CourseRoadmap {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  description       String
  status            CourseRoadmapStatus @default(PLANNED)
  category          String
  estimatedDuration String
  targetDate        DateTime?
  difficulty        DifficultyLevel     @default(BEGINNER)
  prerequisites     String?
  courseLink        String?

  teacherId String?         @db.ObjectId
  teacher   TeacherProfile? @relation("TeacherRoadmaps", fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// ENGAGEMENT MODELS (Reviews, Ratings, Comments)
// ============================================

model Rating {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  value            Int
  courseId         String         @db.ObjectId
  course           Course         @relation(fields: [courseId], references: [id])
  studentProfileId String         @db.ObjectId
  studentProfile   StudentProfile @relation("UserRatings", fields: [studentProfileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([studentProfileId])
  @@index([courseId, value])
}

model Review {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  content          String
  courseId         String         @db.ObjectId
  course           Course         @relation(fields: [courseId], references: [id])
  studentProfileId String         @db.ObjectId
  studentProfile   StudentProfile @relation("UserReviews", fields: [studentProfileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([studentProfileId])
  @@index([courseId, createdAt])
}

model Comment {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  body             String
  studentProfileId String         @db.ObjectId
  studentProfile   StudentProfile @relation("UserComments", fields: [studentProfileId], references: [id])
  courseId         String         @db.ObjectId
  course           Course         @relation(fields: [courseId], references: [id])

  // Self-referential for replies
  parentId String?   @db.ObjectId
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// ENROLLMENT & PROGRESS
// ============================================

model EnrolledStudents {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  studentProfileId String         @db.ObjectId
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])

  courseId String? @db.ObjectId
  course   Course? @relation(fields: [courseId], references: [id])

  certificationId String?        @db.ObjectId
  certification   Certification? @relation(fields: [certificationId], references: [id])

  @@index([studentProfileId])
  @@index([courseId])
  @@index([studentProfileId, courseId])
  @@index([studentProfileId, certificationId])
}

model Progress {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  studentProfileId String         @db.ObjectId
  studentProfile   StudentProfile @relation("Progress", fields: [studentProfileId], references: [id])
  lessonId         String         @db.ObjectId
  lesson           Lesson         @relation(fields: [lessonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isCompleted      Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentProfileId, lessonId], name: "studentProfileId_lessonId")
  @@index([studentProfileId])
  @@index([lessonId])
  @@index([studentProfileId, isCompleted])
}

// ============================================
// SUBSCRIPTION & MEMBERSHIP
// ============================================

model SubscriptionDiscount {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  name               String  @unique
  isDefault          Boolean @default(false)
  discountPercentage Float   @default(0.0)

  SubscriptionPlan SubscriptionPlan[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model SubscriptionPlan {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  name             String            @unique
  type             SubscriptionType?
  regularPrice     Float?
  offerPrice       Float?
  durationInMonths Int?              @default(1)
  durationInYears  Int?              @default(1)
  isDefault        Boolean           @default(false)

  // Trial Configuration
  isTrial             Boolean @default(false)
  trialDurationInDays Int?    @default(30)
  trialCourseLimit    Int     @default(5)

  // Discount
  subscriptionDiscountId String                @db.ObjectId
  subscriptionDiscount   SubscriptionDiscount? @relation(fields: [subscriptionDiscountId], references: [id])

  // Relations
  courses              Course[]
  subscription         Subscription[]
  Purchase             Purchase[]
  bkashPurchaseHistory BkashPurchaseHistory[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model Subscription {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  subscriptionPlanId String?             @db.ObjectId
  subscriptionPlan   SubscriptionPlan?   @relation(fields: [subscriptionPlanId], references: [id])
  expiresAt          DateTime
  status             SubscriptionStatus?

  // Trial Information
  isTrial        Boolean   @default(false)
  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  // Trial Course Selection
  trialSelectedCourseIds String[] @db.ObjectId
  trialSelectedCourses   Course[] @relation("TrialCourses")

  studentProfileId String         @unique @db.ObjectId
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([studentProfileId, status])
  @@index([status, expiresAt])
  @@index([subscriptionPlanId, status])
}

model MembershipPlan {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  prices      Price[]
  Purchase    Purchase[]

  courseIds String[] @db.ObjectId
  courses   Course[] @relation("CourseMemberships", references: [id], fields: [courseIds])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

// ============================================
// PRICING
// ============================================

model Price {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  isFree              Boolean   @default(false)
  regularAmount       Float
  discountedAmount    Float?
  discountExpiresOn   DateTime?
  isLifeTime          Boolean   @default(false)
  duration            Int?
  frequency           Frequency
  isSubscriptionPrice Boolean?  @default(false)
  isMembershipPrice   Boolean?  @default(false)

  // Relations
  membershipPlanId String?         @db.ObjectId
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id])

  bundleId String? @db.ObjectId
  bundle   Bundle? @relation(fields: [bundleId], references: [id])

  certificationId String?        @db.ObjectId
  certification   Certification? @relation(fields: [bundleId], references: [id])

  courseId String? @db.ObjectId
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

// ============================================
// PURCHASE & PAYMENT
// ============================================

model Purchase {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Student
  studentProfileId String         @db.ObjectId
  studentProfile   StudentProfile @relation("StudentPurchases", fields: [studentProfileId], references: [id])

  // Teacher (optional)
  teacherProfileId String?         @db.ObjectId
  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id])

  // Purchased Items
  courseId String? @db.ObjectId
  course   Course? @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  certificationId String?        @db.ObjectId
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  membershipPlanId String?         @db.ObjectId
  membershipPlan   MembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  eventId String? @db.ObjectId
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  subscriptionPlanId String?           @db.ObjectId
  subscription       SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  // Purchase Details
  purchaseType     PurchaseType
  purchaseDuration Int?
  subscriptionId   String?      @db.ObjectId
  expiresAt        DateTime?

  // Payment Breakdown
  totalAmountTk     Float
  creditsUsedTk     Float         @default(0) // Max 80% of total
  totalPaidTk       Float         @default(0) // Sum of all payment methods
  remainingAmountTk Float         @default(0)
  paymentStatus     PaymentStatus @default(PENDING)
  fullyPaidAt       DateTime?

  // Payment Relations - Individual Tables
  creditPayments CreditPayment[]
  mobilePayments MobilePayment[]
  cashPayments   CashPayment[]
  cardPayments   CardPayment[]

  // Revenue Relations
  teacherRevenue     TeacherRevenue[]
  referrerCommission ReferrerCommission[]
  affiliateEarnings  AffiliateEarning[]

  // Wallet transaction relations
  walletTransactions WalletTransaction[] @relation("PurchaseTransactions")

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([studentProfileId])
  @@index([studentProfileId, purchaseType])
  @@index([teacherProfileId])
  @@index([teacherProfileId, createdAt])
  @@index([courseId])
  @@index([subscriptionPlanId])
  @@index([paymentStatus])
  @@index([createdAt])
}

model PurchaseHistory {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  studentProfileId String         @db.ObjectId
  studentProfile   StudentProfile @relation("StudentPurchaseHistory", fields: [studentProfileId], references: [id])
  transactionId    String?
  amount           Float
  unpaidBalance    Float
  subscriptionId   String?        @db.ObjectId
  date             DateTime       @default(now())
}

// ============================================
// PAYMENT METHODS - Individual Tables
// ============================================

model CreditPayment {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId     String        @db.ObjectId
  purchase       Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amountTk       Float
  walletId       String        @db.ObjectId
  transactionId  String        @unique
  status         PaymentStatus @default(COMPLETED)
  idempotencyKey String        @unique
  processedAt    DateTime      @default(now())
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([walletId])
  @@index([status])
}

model MobilePayment {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId          String        @db.ObjectId
  purchase            Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amountTk            Float
  provider            String // bKash, Nagad, Rocket, etc.
  phoneNumber         String
  mobileTransactionId String?
  bkashData           Json? // bKash-specific payment data
  status              PaymentStatus @default(PENDING)
  idempotencyKey      String        @unique
  processedAt         DateTime?
  failureReason       String?
  metadata            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([status])
  @@index([provider])
}

model CashPayment {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId     String        @db.ObjectId
  purchase       Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amountTk       Float
  receivedBy     String? // Staff/Admin name
  receiptNumber  String?       @unique
  status         PaymentStatus @default(COMPLETED)
  idempotencyKey String        @unique
  receivedAt     DateTime      @default(now())
  notes          String?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([status])
}

model CardPayment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  purchaseId      String        @db.ObjectId
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amountTk        Float
  cardType        String? // Visa, Mastercard, Amex, etc.
  cardLast4       String?
  cardBrand       String?
  gatewayProvider String // SSLCommerz, Stripe, etc.
  gatewayTxnId    String?
  status          PaymentStatus @default(PENDING)
  idempotencyKey  String        @unique
  processedAt     DateTime?
  failureReason   String?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([status])
  @@index([gatewayProvider])
}

// ============================================
// TEACHER REVENUE & PAYMENTS
// ============================================

model TeacherRank {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String           @unique
  description     String
  numberOfSales   Int
  feePercentage   Int
  teacherProfiles TeacherProfile[] @relation("TeacherRankProfiles")
  teacherRevenues TeacherRevenue[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model TeacherRevenue {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  teacherProfileId String         @db.ObjectId
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  teacherRankId    String?        @db.ObjectId
  teacherRank      TeacherRank?   @relation(fields: [teacherRankId], references: [id])
  purchaseId       String         @db.ObjectId
  purchase         Purchase       @relation(fields: [purchaseId], references: [id])
  amount           Float          @default(0.0)
  month            Int
  year             Int

  createdAt DateTime @default(now())

  @@index([teacherProfileId])
  @@index([teacherProfileId, month, year])
  @@index([purchaseId])
  @@index([month, year])
}

model TeacherMonthlyEarnings {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  teacherProfileId String         @db.ObjectId
  teacherProfile   TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  month            Int
  year             Int
  total_earned     Float          @default(0.0)

  createdAt DateTime @default(now())
}

model TeacherPayments {
  id               String               @id @default(auto()) @map("_id") @db.ObjectId
  teacherProfileId String               @db.ObjectId
  teacherProfile   TeacherProfile       @relation(fields: [teacherProfileId], references: [id])
  amount_paid      Float                @default(0.0)
  month_paid_for   Int
  year_paid_for    Int
  payment_status   TeacherPaymentStatus @default(UNPAID)
  payment_date     DateTime?

  createdAt DateTime @default(now())
}

model TeacherBalance {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  teacherProfileId  String         @db.ObjectId
  teacherProfile    TeacherProfile @relation(fields: [teacherProfileId], references: [id])
  month             Int
  year              Int
  total_earned      Float          @default(0.0)
  total_paid        Float          @default(0.0)
  balance_remaining Float          @default(0.0)

  updatedAt DateTime @updatedAt
}

model PayoutRequest {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  payoutType      PayoutType
  requestedAmount Float
  approvedAmount  Float?
  status          PayoutRequestStatus @default(PENDING)
  bankAccountId   String?             @db.ObjectId
  bankAccount     BankAccount?        @relation(fields: [bankAccountId], references: [id])
  requestedAt     DateTime            @default(now())
  approvedAt      DateTime?
  processedAt     DateTime?
  completedAt     DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  adminNotes      String?
  transactionRef  String?
  metadata        Json?

  // Polymorphic relations
  teacherProfileId   String?           @db.ObjectId
  teacherProfile     TeacherProfile?   @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  affiliateProfileId String?           @db.ObjectId
  affiliateProfile   AffiliateProfile? @relation(fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherProfileId])
  @@index([affiliateProfileId])
  @@index([status])
  @@index([payoutType])
  @@index([requestedAt])
}

model BankAccount {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  bankName      String
  accountNumber String
  accountName   String
  branch        String?
  routingNumber String?
  swiftCode     String?
  isPrimary     Boolean @default(false)
  isVerified    Boolean @default(false)
  metadata      Json?

  // Polymorphic relations
  teacherProfileId   String?           @db.ObjectId
  teacherProfile     TeacherProfile?   @relation("TeacherBankAccounts", fields: [teacherProfileId], references: [id], onDelete: Cascade)
  affiliateProfileId String?           @db.ObjectId
  affiliateProfile   AffiliateProfile? @relation("AffiliateBankAccounts", fields: [affiliateProfileId], references: [id], onDelete: Cascade)

  payoutRequests PayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherProfileId])
  @@index([affiliateProfileId])
  @@index([isPrimary])
}

// ============================================
// PAYMENT GATEWAY (BKASH)
// ============================================

model Bkash {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  auth_token String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model BkashPurchaseHistory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  bkashPaymentId String?
  email          String
  phoneNumber    String?
  profession     String?
  name           String?
  amount         Float
  purchaseType   PurchaseType

  // Relations
  subscriptionPlanId String?           @db.ObjectId
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])

  eventId String? @db.ObjectId
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  courseId String? @db.ObjectId
  course   Course? @relation(fields: [courseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  certificationId String?        @db.ObjectId
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  creditsUsed  Float @default(0) // Max 80% of total

  walletId    String? @db.ObjectId
  wallet      Wallet? @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// EVENTS
// ============================================

model Event {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String      @unique
  description String?
  price       Float?
  date        DateTime?
  isOnline    Boolean     @default(false)
  location    String?
  zoomLink    String?
  imageUrl    String?
  isPublished Boolean     @default(false)
  mapLocation String?
  type        EventType   @default(EOI)
  status      EventStatus @default(DRAFT)
  faqs        Faq[]
  speakers    Speaker[]

  attendees            EventRegistration[]
  bkashPurchaseHistory BkashPurchaseHistory[]
  purchase             Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventRegistration {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  registeredAt DateTime @default(now())
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])
  eventId      String   @db.ObjectId
  event        Event    @relation(fields: [eventId], references: [id])
  isApproved   Boolean? @default(false)

  @@unique([userId, eventId])
}

// ============================================
// MARKETING & LEADS
// ============================================

model Lead {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String     @unique
  phone           String?
  facebookProfile String?
  linkedin        String?
  whatsapp        String?
  courseId        String?    @db.ObjectId
  eventId         String?    @db.ObjectId
  certificationId String?    @db.ObjectId
  status          LeadStatus @default(INTERESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id    String         @id @default(auto()) @map("_id") @db.ObjectId
  email String         @unique
  tag   NewsletterTag? @relation(fields: [tagId], references: [id])
  tagId String?        @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterTag {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                  String                 @unique
  leads                 Int                    @default(0)
  newsletterSubscribers NewsletterSubscriber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// EMBEDDED TYPES
// ============================================

type Speaker {
  name        String
  designation String?
  avatarUrl   String
}

type Faq {
  question String
  answer   String
}
