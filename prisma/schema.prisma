datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// ENUMS - All enumerations grouped together
// ============================================

// User & Account Enums
enum Role {
  TEACHER
  STUDENT
  ADMIN
  AFFILIATE
}

enum UserAccountStatus {
  ACTIVE
  DEACTIVE
  SUSPENDED
  CLOSED
}

enum UserPlanType {
  NONE
  PRIME_TRIAL
  PRIME
}

// Teacher Enums
enum TeacherStatus {
  NONE
  VERIFIED
  REJECTED
  PENDING
}

enum TeacherExpertiseLevel {
  ENTRY_LEVEL
  MID_LEVEL
  EXPERT
}

enum TeacherPaymentStatus {
  PAID
  UNPAID
  DUE
}

// Affiliate Enums
enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

// Course Enums
enum CourseOwnership {
  TEACHER
  COMPANY
}

enum CourseMode {
  RECORDED
  LIVE
}

enum CourseType {
  MINI
  MICRO
  SHORT
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseRoadmapStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum VideoUploadingStatus {
  PROCESSING
  READY
}

// Subscription & Pricing Enums
enum SubscriptionType {
  NONE
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum Frequency {
  MONTHLY
  YEARLY
  LIFETIME
}

// Purchase Enums
enum PurchaseType {
  SINGLE_COURSE
  MEMBERSHIP
  CERTIFICATION
  SUBSCRIPTION
  TRIAL
  OFFER
  EVENT
}

// Referral & Wallet Enums
enum ReferrerType {
  STUDENT
  TEACHER
  AFFILIATE
}

enum ReferralProgram {
  STUDENT_REF
  TEACHER_REF
  AFFILIATE_REF
}

enum ReferralStatus {
  CLICKED
  REGISTERED
  PAID_LITE
  PAID_PRIME
  CREDITED
  BLOCKED
}

enum ReferralEventType {
  CLICK
  REGISTER
  PURCHASE
  CREDIT_AWARDED
  BLOCKED
  MILESTONE_REACHED
}

enum WalletTransactionType {
  REFERRAL_BONUS
  MILESTONE_BONUS
  ADMIN_CREDIT
  ADMIN_DEBIT
  PURCHASE_DEDUCTION
  REFUND
  EXPIRY
  PROMOTIONAL
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PayoutRequestStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

enum PayoutType {
  TEACHER_REVENUE
  AFFILIATE_COMMISSION
}

// Payment Method Enums
enum PaymentMethodType {
  CREDIT
  MOBILE
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Event & Lead Enums
enum EventType {
  EOI
  PAID
  FREE
}

enum EventStatus {
  DRAFT
  UPCOMING
  CLOSED
}

enum LeadStatus {
  INTERESTED
  WAITING
}

// ============================================
// CORE USER MODELS
// ============================================

model User {
  id                     String            @id @default(auto()) @map("_id") @db.ObjectId
  name                   String
  username               String            @unique
  email                  String            @unique
  avatarUrl              String?
  emailVerified          Boolean           @default(false)
  emailVerificationToken String?
  resetToken             String?
  tokenUsed              Boolean?
  password               String?
  isAdmin                Boolean           @default(false)
  isSuperAdmin           Boolean           @default(false)
  role                   Role              @default(STUDENT)
  accountStatus          UserAccountStatus @default(ACTIVE)

  // Profile Information
  bio         String?
  dateOfBirth DateTime?
  gender      String?
  education   String[]
  nationality String?
  phoneNumber String?
  profession  String?
  city        String?
  state       String?
  country     String?
  zipCode     String?

  // Social Links
  facebook String?
  linkedin String?
  twitter  String?
  youtube  String?
  website  String?
  others   String?

  // Plan & Referral Information
  currentPlan           UserPlanType @default(NONE)
  referralCode          String?      @unique
  referredByUserId      String?      @db.ObjectId
  referredBy            User?        @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referrals             User[]       @relation("UserReferrals")
  upgradeOfferExpiresAt DateTime?
  primeUpgradedAt       DateTime?

  // Relations
  teacherProfile      TeacherProfile?
  studentProfile      StudentProfile?
  affiliateProfile    AffiliateProfile?
  wallet              Wallet?
  referralsAsReferrer Referral[]          @relation("ReferrerRelation")
  referralAsReferee   Referral?           @relation("RefereeRelation")
  eventRegistrations  EventRegistration[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@index([referredByUserId])
  @@index([currentPlan])
  @@index([role])
}

model StudentProfile {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Learning Relations
  enrolledCourseIds EnrolledStudents[]
  progress          Progress[]         @relation("Progress")
  subscription      Subscription?

  // Purchase & Financial Relations
  purchases       Purchase[]        @relation("StudentPurchases")
  purchaseHistory PurchaseHistory[] @relation("StudentPurchaseHistory")

  // Engagement Relations
  ratings  Rating[]  @relation("UserRatings")
  reviews  Review[]  @relation("UserReviews")
  comments Comment[] @relation("UserComments")

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model TeacherProfile {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String        @unique @db.ObjectId
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherStatus     TeacherStatus @default(NONE)
  totalSales        Int           @default(0)
  lastPaymentDate   DateTime?
  lastPaymentAmount Float?

  // Professional Information
  subjectSpecializations String[]
  certifications         String[]
  yearsOfExperience      String?
  expertiseLevel         TeacherExpertiseLevel?

  // Teacher Rank
  teacherRankId String?      @db.ObjectId
  teacherRank   TeacherRank? @relation("TeacherRankProfiles", fields: [teacherRankId], references: [id])

  // Created Content
  createdCourses        Course[]        @relation("TeacherCourses")
  createdCertifications Certification[] @relation("TeacherCertifications")
  courseRoadmap         CourseRoadmap[] @relation("TeacherRoadmaps")

  // Co-teaching Relations
  coTeachingCourseIds        String[]        @db.ObjectId
  coTeachingCourses          Course[]        @relation("CourseCoTeachers", fields: [coTeachingCourseIds], references: [id])
  coTeachingCertificationIds String[]        @db.ObjectId
  coTeachingCertifications   Certification[] @relation("CertificationCoTeachers", fields: [coTeachingCertificationIds], references: [id])

  // Financial Relations
  bankAccounts           BankAccount[]            @relation("TeacherBankAccounts")
  purchases              Purchase[]
  teacherRevenue         TeacherRevenue[]
  teacherMonthlyEarnings TeacherMonthlyEarnings[]
  teacherPayments        TeacherPayments[]
  teacherBalance         TeacherBalance[]
  payoutRequests         PayoutRequest[]

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt
}

model AffiliateProfile {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @unique @db.ObjectId
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliateStatus AffiliateStatus @default(PENDING)

  // Affiliate Information
  companyName     String?
  taxId           String?
  commissionRate  Float     @default(10) // Default 10% commission
  totalEarnings   Float     @default(0)
  pendingEarnings Float     @default(0)
  paidEarnings    Float     @default(0)
  totalReferrals  Int       @default(0)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?

  // Relations
  bankAccounts   BankAccount[]      @relation("AffiliateBankAccounts")
  earnings       AffiliateEarning[]
  payoutRequests PayoutRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateStatus])
}

// ============================================
// WALLET SYSTEM
// ============================================

model Wallet {
  id                    String              @id @default(auto()) @map("_id") @db.ObjectId
  userId                String              @unique @db.ObjectId
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalCredits          Float               @default(0)
  availableCredits      Float               @default(0)
  expiredCredits        Float               @default(0)
  usedCredits           Float               @default(0)
  lifetimeEarnedCredits Float               @default(0)
  transactions          WalletTransaction[]
  creditLots            CreditLot[]

  purchaseHistory  BkashPurchaseHistory[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([availableCredits])
}

model WalletTransaction {
  id             String                  @id @default(auto()) @map("_id") @db.ObjectId
  walletId       String                  @db.ObjectId
  wallet         Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type           WalletTransactionType
  amount         Float
  balanceBefore  Float
  balanceAfter   Float
  status         WalletTransactionStatus @default(COMPLETED)
  description    String?
  // Generic reference fields for polymorphic relationships
  referenceId    String?                 @db.ObjectId
  referenceType  String?                 // "REFERRAL", "MILESTONE", "PURCHASE", "CREDIT_LOT", "PROMOTIONAL_CAMPAIGN"

  idempotencyKey String                  @unique
  metadata       Json?

  // Explicit relations for type safety and queries
  // These are optional and mutually exclusive based on referenceType
  referralId          String?            @db.ObjectId
  referral            Referral?          @relation("ReferralTransactions", fields: [referralId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  
  referralMilestoneId String?            @db.ObjectId
  referralMilestone   ReferralMilestone? @relation("MilestoneTransactions", fields: [referralMilestoneId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  
  purchaseId          String?            @db.ObjectId
  purchase            Purchase?          @relation("PurchaseTransactions", fields: [purchaseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([referenceId, referenceType])
  @@index([referralId])
  @@index([referralMilestoneId])
  @@index([purchaseId])
}

model CreditLot {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  walletId          String   @db.ObjectId
  wallet            Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  initialAmount     Float
  remainingAmount   Float
  expiresAt         DateTime
  isExpired         Boolean  @default(false)
  source            String
  sourceReferenceId String?  @db.ObjectId
  metadata          Json?
  

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([expiresAt, isExpired])
  @@index([remainingAmount])
}

// ============================================
// REFERRAL SYSTEM
// ============================================

model Referral {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  referrerUserId String          @db.ObjectId
  referrer       User            @relation("ReferrerRelation", fields: [referrerUserId], references: [id], onDelete: Cascade)
  refereeUserId  String          @unique @db.ObjectId
  referee        User            @relation("RefereeRelation", fields: [refereeUserId], references: [id], onDelete: Cascade)
  referrerType   ReferrerType
  program        ReferralProgram
  referralCode   String
  status         ReferralStatus  @default(CLICKED)

  // Attribution Tracking
  clickedAt       DateTime?
  registeredAt    DateTime?
  firstPurchaseAt DateTime?
  primeUpgradeAt  DateTime?
  creditedAt      DateTime?

  // Conversion Window
  conversionWindowEndsAt DateTime?

  // Guardrails
  idempotencyKey String  @unique
  blockedReason  String?
  isBlocked      Boolean @default(false)

  // Relations
  // events      ReferralEvent[]
  milestones  ReferralMilestone[]
  commissions ReferrerCommission[]
  walletTransactions WalletTransaction[] @relation("ReferralTransactions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerUserId])
  @@index([status])
  @@index([referralCode])
  @@index([referrerUserId, status])
  @@index([conversionWindowEndsAt])
}

